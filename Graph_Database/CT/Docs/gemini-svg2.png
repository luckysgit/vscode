<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1120" width="100%" height="100%">
  <defs>
    <style>
      .title-text { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 700; fill: #ffffff; text-anchor: middle; }
      .node-title { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 700; font-size: 15px; fill: #0f172a; text-anchor: middle; }
      .node-sub { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 500; font-size: 12px; fill: #475569; text-anchor: middle; }
      .line { stroke: #64748b; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; fill: none; }
      .arrow { fill: #64748b; }
      .card-shadow { filter: drop-shadow(0 4px 6px -1px rgba(0, 0, 0, 0.07)) drop-shadow(0 2px 4px -2px rgba(0, 0, 0, 0.05)); }
    </style>

    <marker id="arrowhead" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
      <path d="M 0 1.5 L 6 4 L 0 6.5 z" class="arrow" />
    </marker>
  </defs>

  <!-- Background Canvas -->
  <rect width="1000" height="1120" fill="#f8fafc" rx="16" />

  <!-- Connecting Lines -->
  <!-- Level 1 (THREAT) to Level 2 (ACTOR, INTENT, CAPABILITY) -->
  <path d="M 500 80 L 500 120 M 200 120 L 800 120" class="line" />
  <path d="M 200 120 L 200 142" class="line" marker-end="url(#arrowhead)" />
  <path d="M 500 120 L 500 142" class="line" marker-end="url(#arrowhead)" />
  <path d="M 800 120 L 800 142" class="line" marker-end="url(#arrowhead)" />

  <!-- Level 2 (ACTOR) to Level 3 (Individual, Group, Network) -->
  <path d="M 200 205 L 200 245 M 90 245 L 310 245" class="line" />
  <path d="M 90 245 L 90 267" class="line" marker-end="url(#arrowhead)" />
  <path d="M 200 245 L 200 267" class="line" marker-end="url(#arrowhead)" />
  <path d="M 310 245 L 310 267" class="line" marker-end="url(#arrowhead)" />

  <!-- Level 3 (Network) to Level 4 (SUPPORT SYSTEM) -->
  <path d="M 310 320 L 310 352" class="line" marker-end="url(#arrowhead)" />

  <!-- Level 4 (SUPPORT SYSTEM) to Level 5 (Personnel, Logistics, Technology) -->
  <path d="M 310 405 L 310 440 M 160 440 L 460 440" class="line" />
  <path d="M 160 440 L 160 457" class="line" marker-end="url(#arrowhead)" />
  <path d="M 310 440 L 310 457" class="line" marker-end="url(#arrowhead)" />
  <path d="M 460 440 L 460 457" class="line" marker-end="url(#arrowhead)" />

  <!-- Support Branches converge down to Central Trunk (TARGET) -->
  <path d="M 160 515 L 160 545 M 460 515 L 460 545 M 160 545 L 460 545" class="line" />
  <path d="M 310 515 L 310 545" class="line" />
  <!-- Bridge from support tree (x=310) to center axis (x=500) -->
  <path d="M 310 545 L 500 545 L 500 572" class="line" marker-end="url(#arrowhead)" />

  <!-- TARGET -> PLAN -> THREAT ASSESSMENT -->
  <path d="M 500 635 L 500 662" class="line" marker-end="url(#arrowhead)" />
  <path d="M 500 725 L 500 752" class="line" marker-end="url(#arrowhead)" />

  <!-- THREAT ASSESSMENT -> Likelihood & Impact -->
  <path d="M 500 805 L 500 835 M 380 835 L 620 835" class="line" />
  <path d="M 380 835 L 380 852" class="line" marker-end="url(#arrowhead)" />
  <path d="M 620 835 L 620 852" class="line" marker-end="url(#arrowhead)" />

  <!-- Likelihood & Impact converge to RISK -->
  <path d="M 380 905 L 380 930 M 620 905 L 620 930 M 380 930 L 620 930" class="line" />
  <path d="M 500 930 L 500 952" class="line" marker-end="url(#arrowhead)" />

  <!-- RISK -> RESPONSE / MITIGATION -->
  <path d="M 500 1005 L 500 1032" class="line" marker-end="url(#arrowhead)" />

  <!-- Nodes -->

  <!-- Top Root: THREAT -->
  <g class="card-shadow">
    <rect x="410" y="25" width="180" height="55" rx="10" fill="#dc2626" stroke="#b91c1c" stroke-width="1.5" />
    <text x="500" y="60" class="title-text" font-size="19" letter-spacing="1.5">THREAT</text>
  </g>

  <!-- Level 2: Core Pillars -->
  <!-- ACTOR -->
  <g class="card-shadow">
    <rect x="110" y="150" width="180" height="55" rx="10" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="200" y="174" class="node-title">ACTOR</text>
    <text x="200" y="193" class="node-sub">("Who?")</text>
  </g>

  <!-- INTENT -->
  <g class="card-shadow">
    <rect x="395" y="150" width="210" height="55" rx="10" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="500" y="174" class="node-title">INTENT</text>
    <text x="500" y="193" class="node-sub">("What do they want?")</text>
  </g>

  <!-- CAPABILITY -->
  <g class="card-shadow">
    <rect x="700" y="150" width="200" height="55" rx="10" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="800" y="174" class="node-title">CAPABILITY</text>
    <text x="800" y="193" class="node-sub">("Can they do it?")</text>
  </g>

  <!-- Level 3: Actor Types -->
  <!-- Individual -->
  <g class="card-shadow">
    <rect x="40" y="275" width="100" height="45" rx="8" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
    <text x="90" y="303" class="node-title" font-size="14">Individual</text>
  </g>

  <!-- Group -->
  <g class="card-shadow">
    <rect x="155" y="275" width="90" height="45" rx="8" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
    <text x="200" y="303" class="node-title" font-size="14">Group</text>
  </g>

  <!-- Network -->
  <g class="card-shadow">
    <rect x="260" y="275" width="100" height="45" rx="8" fill="#eff6ff" stroke="#93c5fd" stroke-width="1.5" />
    <text x="310" y="303" class="node-title" font-size="14" fill="#1d4ed8">Network</text>
  </g>

  <!-- Level 4: Support System -->
  <g class="card-shadow">
    <rect x="210" y="360" width="200" height="45" rx="8" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5" />
    <text x="310" y="388" class="node-title" font-size="13" fill="#334155" letter-spacing="0.5">SUPPORT SYSTEM</text>
  </g>

  <!-- Level 5: Support Branches (Finance removed) -->
  <!-- Personnel -->
  <g class="card-shadow">
    <rect x="90" y="465" width="140" height="50" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="160" y="487" class="node-title" font-size="13">Personnel</text>
    <text x="160" y="503" class="node-sub" font-size="11">(Recruitment)</text>
  </g>

  <!-- Logistics -->
  <g class="card-shadow">
    <rect x="245" y="465" width="130" height="50" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="310" y="487" class="node-title" font-size="13">Logistics</text>
    <text x="310" y="503" class="node-sub" font-size="11">(Travel)</text>
  </g>

  <!-- Technology -->
  <g class="card-shadow">
    <rect x="390" y="465" width="140" height="50" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="460" y="487" class="node-title" font-size="13">Technology</text>
    <text x="460" y="503" class="node-sub" font-size="11">(Comms/Infra)</text>
  </g>

  <!-- Level 6: TARGET -->
  <g class="card-shadow">
    <rect x="370" y="580" width="260" height="55" rx="10" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="500" y="604" class="node-title">TARGET</text>
    <text x="500" y="623" class="node-sub">("What could be attacked?")</text>
  </g>

  <!-- Level 7: PLAN -->
  <g class="card-shadow">
    <rect x="370" y="670" width="260" height="55" rx="10" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="500" y="694" class="node-title">PLAN</text>
    <text x="500" y="713" class="node-sub">("What is being prepared?")</text>
  </g>

  <!-- Level 8: THREAT ASSESSMENT -->
  <g class="card-shadow">
    <rect x="380" y="760" width="240" height="45" rx="8" fill="#f8fafc" stroke="#64748b" stroke-width="1.5" />
    <text x="500" y="788" class="node-title" font-size="14" fill="#0f172a" letter-spacing="0.5">THREAT ASSESSMENT</text>
  </g>

  <!-- Level 9: Likelihood & Impact -->
  <!-- Likelihood -->
  <g class="card-shadow">
    <rect x="320" y="860" width="120" height="45" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="380" y="888" class="node-title" font-size="14">Likelihood</text>
  </g>

  <!-- Impact -->
  <g class="card-shadow">
    <rect x="560" y="860" width="120" height="45" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
    <text x="620" y="888" class="node-title" font-size="14">Impact</text>
  </g>

  <!-- Level 10: RISK -->
  <g class="card-shadow">
    <rect x="420" y="960" width="160" height="45" rx="8" fill="#fef2f2" stroke="#f87171" stroke-width="1.5" />
    <text x="500" y="988" class="node-title" font-size="15" fill="#dc2626" letter-spacing="0.5">RISK</text>
  </g>

  <!-- Level 11: RESPONSE / MITIGATION -->
  <g class="card-shadow">
    <rect x="360" y="1040" width="280" height="50" rx="10" fill="#0f172a" stroke="#0f172a" stroke-width="1.5" />
    <text x="500" y="1071" class="title-text" font-size="15" letter-spacing="1">RESPONSE / MITIGATION</text>
  </g>
</svg>
