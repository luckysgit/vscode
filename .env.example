# API Keys - Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git - add it to .gitignore

# Groq API Key (for LLM queries)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (alternative LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google API Key (for Google services)
GOOGLE_API_KEY=your_google_api_key_here

# Neo4j Configuration
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=your_database_name
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=Your Instance Name
